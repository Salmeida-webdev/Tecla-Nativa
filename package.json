{
  "name": "tecla-nativa-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "pregenerate": "node scripts/generate-sitemap.mjs",
    "typecheck": "nuxt prepare && vue-tsc --noEmit",
    "test": "node --test utils/catalog.test.mjs supabase/functions/_shared/commerce.test.mjs supabase/functions/_shared/http-response.test.mjs supabase/functions/_shared/melhor-envio-oauth.test.mjs supabase/functions/_shared/webhooks.test.mjs",
    "test:db": "npx --yes supabase@latest db test --local",
    "preview": "node scripts/preview-static.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:security": "node scripts/verify-security-patches.mjs",
    "verify:webhooks": "node --test supabase/functions/_shared/webhooks.test.mjs",
    "check:all": "npm run typecheck && npm test && npm run verify:catalog && npm run verify:security && npm run verify:webhooks && npm run generate && npm run verify:build",
    "lint:db": "npx --yes supabase@latest db lint --local"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "pinia": "^3.0.3"
  },
  "devDependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@playwright/test": "^1.64.1",
    "braces": "file:vendor/braces",
    "node-forge": "file:vendor/node-forge",
    "nuxt": "4.6.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "braces": "$braces",
    "node-forge": "$node-forge"
  }
}
